{
  "openapi": "3.0.3",
  "info": {
    "title": "LinkHub API",
    "description": "Branded short links, link-in-bio profiles, QR codes and click analytics.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api" }],
  "tags": [
    { "name": "Auth" },
    { "name": "Links" },
    { "name": "Redirect" },
    { "name": "Analytics" },
    { "name": "Bio" },
    { "name": "Meta" }
  ],
  "security": [],
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "access_token" },
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "example": "user" },
          "isEmailVerified": { "type": "boolean" }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "destinationUrl": { "type": "string" },
          "shortCode": { "type": "string" },
          "shortUrl": { "type": "string" },
          "clickCount": { "type": "integer" },
          "isActive": { "type": "boolean" },
          "expiresAt": { "type": "string", "format": "date-time", "nullable": true },
          "hasPassword": { "type": "boolean" },
          "isExpired": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "SocialLink": {
        "type": "object",
        "properties": {
          "platform": { "type": "string" },
          "label": { "type": "string", "nullable": true },
          "url": { "type": "string" },
          "order": { "type": "integer" },
          "clicks": { "type": "integer" }
        }
      },
      "BioProfile": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "avatar": { "type": "string", "nullable": true },
          "displayName": { "type": "string" },
          "bio": { "type": "string" },
          "theme": {
            "type": "string",
            "enum": ["Minimal Light", "Dark Slate", "Gradient", "Sunset Glow", "Ocean Night", "Mint Light"]
          },
          "socialLinks": { "type": "array", "items": { "$ref": "#/components/schemas/SocialLink" } }
        }
      },
      "DateRange": {
        "type": "object",
        "properties": {
          "startDate": { "type": "string", "format": "date", "description": "Default: 7 days ago" },
          "endDate": { "type": "string", "format": "date", "description": "Default: today" }
        }
      }
    },
    "parameters": {
      "StartDate": { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date" } },
      "EndDate": { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date" } },
      "Limit50": { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10, "minimum": 1, "maximum": 50 } }
    }
  },
  "paths": {
    "/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registered; verification email sent (or console-logged in dev)" },
          "400": { "description": "Validation failed" },
          "409": { "description": "Email already in use" }
        }
      }
    },
    "/v1/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify email address",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["token"], "properties": { "token": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Email verified" }, "400": { "description": "Invalid or expired token" } }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login (sets httpOnly cookies, returns token pair)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": { "email": { "type": "string" }, "password": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in" },
          "401": { "description": "Invalid credentials" },
          "403": { "description": "Email not verified" }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate session tokens",
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Tokens rotated" }, "401": { "description": "Invalid or revoked refresh token" } }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke refresh token and clear cookies",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Logged out" } }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current user",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Current user" }, "401": { "description": "Unauthenticated" } }
      }
    },
    "/v1/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request password reset (always returns a generic message)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Reset instructions generated" } }
      }
    },
    "/v1/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset password with token (revokes all sessions)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "password"],
                "properties": { "token": { "type": "string" }, "password": { "type": "string", "minLength": 8 } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Password reset" }, "400": { "description": "Invalid or expired token" } }
      }
    },
    "/v1/links": {
      "post": {
        "tags": ["Links"],
        "summary": "Create a short link",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["destinationUrl"],
                "properties": {
                  "destinationUrl": { "type": "string", "maxLength": 2048 },
                  "customSlug": { "type": "string", "maxLength": 20 },
                  "expiresAt": { "type": "string", "format": "date-time", "description": "Must be in the future" },
                  "password": { "type": "string", "minLength": 4, "maxLength": 64 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Link created" },
          "400": { "description": "Validation failed / reserved slug / past expiry" },
          "409": { "description": "Short code already in use" }
        }
      },
      "get": {
        "tags": ["Links"],
        "summary": "List own links (paginated, searchable)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10, "maximum": 50 } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "isActive", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "Paginated links" } }
      }
    },
    "/v1/links/{id}": {
      "get": {
        "tags": ["Links"],
        "summary": "Get one own link",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Link" }, "404": { "description": "Link not found" } }
      },
      "patch": {
        "tags": ["Links"],
        "summary": "Update own link (expiresAt/password null clears)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "destinationUrl": { "type": "string", "maxLength": 2048 },
                  "customSlug": { "type": "string", "maxLength": 20 },
                  "isActive": { "type": "boolean" },
                  "expiresAt": { "type": "string", "format": "date-time", "nullable": true },
                  "password": { "type": "string", "minLength": 4, "maxLength": 64, "nullable": true }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Link updated" }, "404": { "description": "Link not found" } }
      },
      "delete": {
        "tags": ["Links"],
        "summary": "Delete own link",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Link deleted" }, "404": { "description": "Link not found" } }
      }
    },
    "/r/{shortCode}": {
      "get": {
        "tags": ["Redirect"],
        "summary": "Resolve short link (302). Records a click event.",
        "parameters": [
          { "name": "shortCode", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "query", "schema": { "type": "string" }, "description": "For password-protected links (or x-link-password header)" }
        ],
        "responses": {
          "302": { "description": "Redirect to destination" },
          "401": { "description": "Password required or incorrect" },
          "404": { "description": "Unknown or disabled link" },
          "410": { "description": "Link expired" }
        }
      }
    },
    "/v1/analytics/overview": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Totals + top link (default trailing 7 days, max 90-day range)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }],
        "responses": { "200": { "description": "{ totalClicks, uniqueVisitors, totalLinks, activeLinks, topLink }" } }
      }
    },
    "/v1/analytics/clicks-over-time": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Zero-filled daily click series",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }],
        "responses": { "200": { "description": "[{ date, clicks }]" } }
      }
    },
    "/v1/analytics/referrers": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Top referrers",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }, { "$ref": "#/components/parameters/Limit50" }],
        "responses": { "200": { "description": "[{ referrer, clicks }]" } }
      }
    },
    "/v1/analytics/devices": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Mobile/Desktop/Tablet distribution with percentages",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }],
        "responses": { "200": { "description": "[{ deviceType, clicks, percentage }]" } }
      }
    },
    "/v1/analytics/browsers": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Clicks by browser",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }, { "$ref": "#/components/parameters/Limit50" }],
        "responses": { "200": { "description": "[{ browser, clicks }]" } }
      }
    },
    "/v1/analytics/os": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Clicks by operating system",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }, { "$ref": "#/components/parameters/Limit50" }],
        "responses": { "200": { "description": "[{ os, clicks }]" } }
      }
    },
    "/v1/analytics/countries": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Clicks by country (provider geo headers; Unknown when absent)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StartDate" }, { "$ref": "#/components/parameters/EndDate" }, { "$ref": "#/components/parameters/Limit50" }],
        "responses": { "200": { "description": "[{ country, clicks }]" } }
      }
    },
    "/v1/analytics/links/{linkId}": {
      "get": {
        "tags": ["Analytics"],
        "summary": "Per-link bundle (owner-checked)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "parameters": [
          { "name": "linkId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/StartDate" },
          { "$ref": "#/components/parameters/EndDate" }
        ],
        "responses": {
          "200": { "description": "{ link, totalClicks, uniqueVisitors, clicksOverTime, referrers, devices, browsers, operatingSystems, countries }" },
          "404": { "description": "Link not found" }
        }
      }
    },
    "/v1/bio/me": {
      "get": {
        "tags": ["Bio"],
        "summary": "Owner's full profile (null when absent)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Profile or null" } }
      }
    },
    "/v1/bio": {
      "post": {
        "tags": ["Bio"],
        "summary": "Create bio profile (one per user)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BioProfile" } } }
        },
        "responses": { "201": { "description": "Created" }, "409": { "description": "Already exists / username taken" } }
      },
      "patch": {
        "tags": ["Bio"],
        "summary": "Partial update (click counts preserved server-side)",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BioProfile" } } } },
        "responses": { "200": { "description": "Updated" }, "404": { "description": "No profile" } }
      },
      "delete": {
        "tags": ["Bio"],
        "summary": "Delete own profile",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/v1/bio/{username}": {
      "get": {
        "tags": ["Bio"],
        "summary": "Public profile (projected fields only)",
        "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Public profile" }, "404": { "description": "Profile not found" } }
      }
    },
    "/v1/bio/{username}/links/{index}/click": {
      "post": {
        "tags": ["Bio"],
        "summary": "Increment a bio social-link counter (aggregate only, no visitor data)",
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "index", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": { "description": "{ clicks }" },
          "400": { "description": "Invalid index" },
          "404": { "description": "Profile or link not found" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Meta"],
        "summary": "Health check",
        "responses": { "200": { "description": "API is running" } }
      }
    },
    "/docs.json": {
      "get": {
        "tags": ["Meta"],
        "summary": "This OpenAPI document",
        "responses": { "200": { "description": "OpenAPI 3.0 JSON" } }
      }
    }
  }
}
