{
  "name": "short-link-bio-hub-server",
  "version": "1.0.0",
  "description": "Backend API for Short-Link & Bio-Link Hub",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/utils/seed.js",
    "test": "node src/__tests__/security.test.js && node src/__tests__/analytics.test.js && node src/__tests__/bio.test.js && node src/__tests__/redirect.test.js && node src/__tests__/validation.test.js",
    "test:security": "node src/__tests__/security.test.js",
    "test:analytics": "node src/__tests__/analytics.test.js",
    "test:bio": "node src/__tests__/bio.test.js",
    "test:redirect": "node src/__tests__/redirect.test.js",
    "test:validation": "node src/__tests__/validation.test.js",
    "test:auth": "node src/__tests__/auth.test.js",
    "test:links": "node src/__tests__/links.test.js",
    "test:bio-full": "node src/__tests__/bio-full.test.js",
    "test:analytics-db": "node src/__tests__/analytics-db.test.js",
    "test:integration": "node src/__tests__/auth.test.js && node src/__tests__/links.test.js && node src/__tests__/bio-full.test.js && node src/__tests__/analytics-db.test.js",
    "test:all": "npm test && npm run test:integration",
    "lint": "eslint src/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
