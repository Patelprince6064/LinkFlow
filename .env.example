# ============================================
# LinkHub — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# Environment: development | production | test
NODE_ENV=development

# Server port
PORT=5000

# MongoDB connection string
# Development: mongodb://localhost:27017/short_link_bio_hub
# Production: mongodb+srv://user:pass@cluster.mongodb.net/short_link_bio_hub
MONGODB_URI=mongodb://localhost:27017/short_link_bio_hub

# Frontend URL (used for CORS and email links)
# Development: http://localhost:5173
# Production: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Backend public URL (used for generating short links)
# Development: http://localhost:5000
# Production: https://your-backend.onrender.com
PUBLIC_BASE_URL=http://localhost:5000

# JWT secrets — generate strong random strings for production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_string_64_chars

# Token expiration
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie configuration
# Production: COOKIE_SECURE=true, COOKIE_SAME_SITE=none (for cross-origin)
# Development: COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend API URL (optional, only if backend is on a different domain)
# If not set, frontend uses relative /api path (recommended for same-domain setups)
# VITE_API_URL=https://your-backend.onrender.com/api
